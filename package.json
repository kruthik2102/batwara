{
  "name": "batwara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first expense splitting for Android. No server: data lives on the phone, groups sync through encrypted files.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "cap:sync": "npx cap sync android",
    "apk:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "jsqr": "^1.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "vite": "^5.4.21"
  }
}
